<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Dm.BuiltinsGen</RootNamespace>
    <AssemblyName>builtins-gen</AssemblyName>

    <!-- A build-time tool, not shipped, so the AOT rules that bind Dm.Core do not apply here. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dm.Core\Dm.Core.csproj" />
  </ItemGroup>

</Project>
