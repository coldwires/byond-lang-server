<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Dm.Core</RootNamespace>
    <!--
      Dm.Core is consumed by Dm.Native, which is a NativeAOT target. Enabling the AOT analyzers
      here makes reflection and dynamic-codegen use a build error in the core rather than a
      publish-time surprise. Dm.Lsp is exempt from AOT, but it shares this assembly, so the
      constraint binds here.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <!--
      CS1591 is deliberately NOT suppressed: every public member was documented on 2026-08-13
      (192 comments, the user's call), so a new public API without a doc comment fails the build
      under TreatWarningsAsErrors. If this ever needs a NoWarn again, the surface has drifted -
      shrink it or document it rather than silencing the gate.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The preprocessor's internals are implementation detail, not API surface, but they need direct
      unit tests. Widening them to public just to test them would freeze decisions we still expect
      to change.
    -->
    <InternalsVisibleTo Include="Dm.Core.Tests" />
    <!--
      dmc is the debug driver and the arbiter, and its instrumentation commands (scan, outline,
      preprocess, the raw tree mode) deliberately reach the lexer, parser and preprocessor layers
      that are NOT the supported API. The supported surface is what Dm.Native and Dm.Lsp consume,
      PLAN.md's §3 sync rule, and dmc seeing past it is the point of dmc.
    -->
    <InternalsVisibleTo Include="dmc" />
  </ItemGroup>

  <ItemGroup>
    <!-- The BYOND standard library, generated by tools/builtins-gen. Embedded so a consumer needs
         nothing beside the assembly. -->
    <EmbeddedResource Include="Resources/builtins.txt" />
  </ItemGroup>

</Project>
