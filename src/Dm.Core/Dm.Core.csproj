<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Dm.Core</RootNamespace>
    <!--
      Dm.Core is consumed by Dm.Native, which is a NativeAOT target. Enabling the AOT analyzers
      here makes reflection and dynamic-codegen use a build error in the core rather than a
      publish-time surprise. Dm.Lsp is exempt from AOT, but it shares this assembly, so the
      constraint binds here.
    -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The preprocessor's internals are implementation detail, not API surface, but they need direct
      unit tests. Widening them to public just to test them would freeze decisions we still expect
      to change.
    -->
    <InternalsVisibleTo Include="Dm.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The BYOND standard library, generated by tools/builtins-gen. Embedded so a consumer needs
         nothing beside the assembly. -->
    <EmbeddedResource Include="Resources/builtins.txt" />
  </ItemGroup>

</Project>
